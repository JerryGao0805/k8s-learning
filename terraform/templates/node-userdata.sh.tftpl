#!/bin/bash
# ------------------------------------------------------------
# K8s 节点首次开机时由 cloud-init 执行。
# 故意只做最少的事：节点准备（containerd、kubeadm……）留给你在第 02 章亲手完成。
# ------------------------------------------------------------
set -euxo pipefail

# 命令行提示符里显示节点角色，例如：(cp-1)ssm-user@ip-10-0-10-11:~$
# 主机名 ip-10-0-10-11 保持 AWS 的默认值，它会成为 K8s 里的节点名，加入集群后不要再改。
echo "${node_name}" > /etc/debian_chroot
